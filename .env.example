# ==============================================================================
# AERO-ASTRA Environment Variables Template
# Copy this file to .env and configure your credentials.
#
# IMPORTANT: Never commit .env to version control.
# ==============================================================================

# ── Required: Nebius Token Factory ───────────────────────────────────────────
# Obtain API key and Base URL from Nebius Token Factory / Nebius AI Studio
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Models for Agent Pipeline:
# SHERLOCK (root-cause diagnosis, graph-constrained classification)
NEBIUS_MODEL_SHERLOCK=nvidia/Nemotron-3_5-Lightning

# ATHENA (multi-step recovery planning, 4096-token structured JSON)
NEBIUS_MODEL_ATHENA=nvidia/nemotron-3-super-120b-a12b

# 1 = production/demo mode (enforces Nebius Token Factory only, no silent fallbacks)
# 0 = development mode (allows local/alternative providers if Nebius is unreachable)
NEBIUS_ONLY=1

# ── Optional: Development Fallbacks (ignored when NEBIUS_ONLY=1) ─────────────
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Local Ollama Fallback
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=mistral-nemo:12b

# ── Vite dev server — WebSocket target (local dev only, do NOT set in production) ──
# Without this, WS would connect to localhost:5173 (Vite) instead of :8000 (backend)
VITE_WS_URL=ws://localhost:8000
